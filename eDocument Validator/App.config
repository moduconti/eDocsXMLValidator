<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Full PDF/A conformance checking (fonts, colour spaces, transparency)
             is delegated to veraPDF, the reference PDF/A validator. The built-in
             checks cover the Factur-X / ZUGFeRD structure, the XMP metadata and
             the PDF-to-XML relationships, and always run regardless of this
             setting. Set enableVeraPdf to true to add the conformance pass. -->
        <add key="enableVeraPdf" value="false" />
        <!-- Optional overrides. When these are empty the application looks for
             veraPDF under tools\verapdf and a Java runtime under tools\jre,
             then falls back to JAVA_HOME and PATH. -->
        <add key="veraPdfHome" value="" />
        <add key="javaExecutable" value="" />
    </appSettings>
    <!-- Draw at the real size of the screen instead of being stretched, so that
         text stays sharp on a display set to 125% or 150%. -->
    <System.Windows.Forms.ApplicationConfigurationSection>
        <add key="DpiAwareness" value="PerMonitorV2" />
    </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
